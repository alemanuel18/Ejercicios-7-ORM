version: '3.8'
services:

  # Contenedor de la Aplicación Laravel
  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: laravel-streaming-app
    container_name: music-app
    restart: unless-stopped
    tty: true
    environment:
      SERVICE_NAME: app
      SERVICE_TAGS: dev
    working_dir: /var/www
    volumes:
      - ./:/var/www
    networks:
      - app-network

  # Contenedor de Base de Datos (PostgreSQL)
  db:
    image: postgres:15-alpine
    container_name: music-db
    restart: unless-stopped
    tty: true
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: streaming_db
      POSTGRES_USER: laravel_user
      POSTGRES_PASSWORD: secret_password
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - app-network

networks:
  app-network:
    driver: bridge

volumes:
  postgres_data: